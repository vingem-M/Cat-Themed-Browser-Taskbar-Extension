{
  "manifest_version": 3,
  "name": "Tab Closer",
  "description": "Quickly find, select, and close crowded Chrome tabs.",
  "version": "1.0.0",
  "minimum_chrome_version": "114",
  "permissions": ["tabs", "sidePanel"],
  "host_permissions": ["https://www.google.com/s2/favicons*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "打开标签抽屉",
    "default_icon": {
      "16": "icons/icon16.svg",
      "32": "icons/icon32.svg",
      "48": "icons/icon48.svg",
      "128": "icons/icon128.svg"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.svg",
    "32": "icons/icon32.svg",
    "48": "icons/icon48.svg",
    "128": "icons/icon128.svg"
  }
}
